# Rust build artifacts
debug/
target/
# Cargo.lock is committed (not ignored) — a plugin is an application, not a
# library, so pinning the exact resolved versions gives reproducible builds.

# Plugin build outputs
dist/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
temp/
